# Repo docs and bootstrap material — live in source, not deployed to $HOME.
README.md
PLAYBOOK.md
bootstrap

# Tests for the scripts in dot_local/bin. Unlisted, chezmoi would deploy ~/tests.
tests

# Per-machine, generated by other tools. nwg-displays writes BOTH files on every
# save -- monitors.conf for a hyprlang config and monitors.lua for the Lua one.
# hyprland.lua reads monitors.lua; the .conf is inert but listed so it does not
# become standing noise in `chezmoi unmanaged .config/hypr`. workspaces.* is
# nwg-displays' workspace-assignment output (hence app-workspaces.lua for ours).
.config/hypr/monitors.conf
.config/hypr/monitors.lua
.config/hypr/workspaces.lua

# DankMaterialShell's own Hyprland fragments (outputs, layout, cursor, window
# rules, binds-user from its keybind editor). DMS writes them from its Settings
# UI and they are per-machine; hyprland.lua loads them in the DMS session only.
.config/hypr/dms

# systemd user manager's enable/start state (symlinks, per-machine).
.config/systemd/user/*.wants

# Python bytecode cache — never deploy it. Glob rather than a per-directory list:
# .gitignore hides these from git, but chezmoi does not read .gitignore, so an
# unlisted one (e.g. next to reading-column.py) silently ships a .pyc into $HOME.
**/__pycache__

{{- /* Mail stack (notmuch + lieer for Gmail) is opt-in per machine.
       Toggle via the `mailSetup` prompt in .chezmoi.toml.tmpl. The Doom
       :email module + config.el notmuch block are gated inline in
       init.el.tmpl / config.el.tmpl, so those files themselves stay
       managed regardless. */}}
{{- if not .mailSetup }}
.notmuch-config
.local/bin/mail-sync
.local/bin/mail-creds-bootstrap
.config/systemd/user/mail-sync.service
.config/systemd/user/mail-sync.timer
{{- end }}

{{- /* LAN git peering is opt-in per machine, like the mail stack above.
       Toggle via the `gitPeerSetup` prompt in .chezmoi.toml.tmpl.
       `dig` rather than a bare `.gitPeerSetup` so that a config generated
       before these keys existed still applies instead of erroring on a
       missing key -- that would otherwise break `chezmoi apply` on every
       machine until `chezmoi init` had been re-run. */}}
{{- if not (dig "gitPeerSetup" false .) }}
.local/bin/git-peer
.local/bin/git-peer-bootstrap
.config/git-peer
{{- end }}

{{- /* Registry logins come from 1Password through ~/.local/bin/docker-credential-op, never from a
       `podman login`/`docker login` on disk. Only where 1Password is the password manager; `dig`
       for the same reason as gitPeerSetup above. */}}
{{- if ne (dig "passwordManager" "none" .) "1password" }}
.local/bin/docker-credential-op
.config/containers/auth.json
.local/bin/glab
{{- end }}
