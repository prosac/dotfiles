# Repo docs and bootstrap material — live in source, not deployed to $HOME.
README.md
PLAYBOOK.md
bootstrap

# Per-machine, generated by other tools. nwg-displays writes BOTH files on every
# save -- monitors.conf for the hyprland config and monitors.lua for the newer
# lua one. Nothing here sources the .lua (hyprland.conf.tmpl reads monitors.conf),
# so it is inert, but leaving it unlisted made it the only entry in
# `chezmoi unmanaged .config/hypr` -- standing noise in the one command whose job
# is to surface a config file that escaped the repo.
.config/hypr/monitors.conf
.config/hypr/monitors.lua

# systemd user manager's enable/start state (symlinks, per-machine).
.config/systemd/user/*.wants

# Python bytecode cache — never deploy it. Glob rather than a per-directory list:
# .gitignore hides these from git, but chezmoi does not read .gitignore, so an
# unlisted one (e.g. next to reading-column.py) silently ships a .pyc into $HOME.
**/__pycache__

{{- /* Mail stack (notmuch + lieer for Gmail) is opt-in per machine.
       Toggle via the `mailSetup` prompt in .chezmoi.toml.tmpl. The Doom
       :email module + config.el notmuch block are gated inline in
       init.el.tmpl / config.el.tmpl, so those files themselves stay
       managed regardless. */}}
{{- if not .mailSetup }}
.notmuch-config
.local/bin/mail-sync
.local/bin/mail-creds-bootstrap
.config/systemd/user/mail-sync.service
.config/systemd/user/mail-sync.timer
{{- end }}
