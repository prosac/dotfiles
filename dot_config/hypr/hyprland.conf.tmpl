
# #######################################################################################
# AUTOGENERATED HYPR CONFIG.
# PLEASE USE THE CONFIG PROVIDED IN THE GIT REPO /examples/hypr.conf AND EDIT IT,
# OR EDIT THIS ONE ACCORDING TO THE WIKI INSTRUCTIONS.
# #######################################################################################


# This is an example Hyprland config file.
# Refer to the wiki for more information.
# https://wiki.hyprland.org/Configuring/

# Please note not all available settings / options are set here.
# For a full list, see the wiki

# You can split this configuration into multiple files
# Create your files separately and then link them to this file like this:
# source = ~/.config/hypr/myColors.conf


################
### MONITORS ###
################

# See https://wiki.hyprland.org/Configuring/Monitors/
# Managed by nwg-displays
source = ~/.config/hypr/monitors.conf
source = ~/.config/hypr/workspaces.conf


###################
### MY PROGRAMS ###
###################

# See https://wiki.hyprland.org/Configuring/Keywords/

# Set programs that you use
$terminal = ghostty
$fileManager = dolphin
$menu = walker


#################
### AUTOSTART ###
#################

# Autostart necessary processes (like notifications daemons, status bars, etc.)
# Or execute your favorite apps at launch like this:

# exec-once = $terminal
# exec-once = nm-applet &
# exec-once = waybar & hyprpaper & firefox

# Setup persistent workspaces, monitor pinning, and display names.
# (setup_workspaces.sh handles renames internally — see comments there.)
exec = ~/.config/hypr/setup_workspaces.sh

# Keep workspace pinning in sync with the connected monitors so workspaces
# re-pin + migrate when HDMI / DP monitors come and go — without a Hyprland
# reload. Level-triggered (reconciles against the actual monitor set, with a
# periodic safety-net), so a dropped monitoradded edge — e.g. from a Meet
# screen-share output churn or dock/undock — self-heals instead of leaving the
# layout stuck undocked.
exec-once = ~/.config/hypr/monitor-hotplug.py

# Reading-column daemon. Two behaviours (see the script's docstring):
#   * AUTO — a single tiled window on a WIDE monitor (>= 2000px logical, i.e. the
#     ultrawide, not the 1440px laptop) is centered into a ~1250px column. The
#     laptop keeps normal small gaps for a lone window.
#   * MANUAL reading mode — Super+C (below) toggles a narrow ~800px column on the
#     focused workspace, on any monitor, for focused reading.
# Resets to normal tiling for 0 or 2+ windows. Native w[tv1] smart-gaps can't do
# this (fixed px would break the narrow laptop), hence the socket2 listener.
# See the reading-column note in ~/Documents/docs/.
exec-once = ~/.config/hypr/reading-column.py

# hyprtasking — workspace overview plugin (Super+Tab). Built by hand rather than
# via hyprpm: upstream only supports Hyprland up to v0.56.0, so this is the
# unmerged PR #123 fix for 0.56.1 (raybbian/hyprtasking#123, fork yerlotic, 2
# commits = +4/-4 porting getWorkspaceByID/createNewWorkspace to the new
# State::workspaceState() API). Source: ~/.local/src/hyprtasking @ ee5b4c6688.
#
# ⚠️ Hyprland plugins are ABI-pinned to the exact compositor build. EVERY Hyprland
# update needs `~/.local/bin/hyprtasking-rebuild` (rebuild against the new
# headers) or this load fails and the overview is silently gone — hence the
# fallback notification. Swap back to `hyprpm` once #123 merges upstream.
#
# ⚠️ The success test is `grep -q '^ok'`, NOT the exit code: `hyprctl plugin load`
# prints "could not be loaded: …" and still exits 0, so a plain `||` fallback
# would never fire and the failure would stay silent — the very thing it guards.
# See ~/Documents/docs/hyprland-hyprtasking-plugin.md
# `--ensure` loads the existing build and rebuilds ONLY if it will not load, so a
# normal login compiles nothing. It replaces a bare `plugin load` that merely
# NOTIFIED on failure: after a routine `dnf update` bumped hyprland 0.56.2-1 -> -2
# on 2026-08-31 the ABI-pinned .so stopped loading, and the session came up with
# `hyprtasking:toggle` undefined and Hyprland's on-screen Error Overlay listing it.
# A notification asking for a manual rebuild is not a fix when the thing it is
# telling you about is already covering your screen.
exec-once = ~/.local/bin/hyprtasking-rebuild --ensure

# swayosd-server runs as a systemd user service (swayosd.service), bound to
# graphical-session.target, so it is not started here.

# Apply current color-scheme to Hyprland borders + waybar CSS at startup
# so the visual state matches gsettings on every login.
exec-once = ~/.local/bin/toggle-color-scheme --apply

# Wallpaper: the awww daemon and wallpaper restore run as systemd user services
# (awww.service + waypaper.service). waypaper.service is ordered After=awww.service,
# and awww.service only reports active once its socket answers, so the daemon is
# guaranteed ready before `waypaper --restore` sets the image (no sleep race).
# Super+W opens the waypaper GUI. Terra's awww Obsoletes swww without Providing
# it, so there is no swww binary; waypaper's native `awww` backend is used rather
# than /usr/local/bin shims, which gave one daemon two names and let waypaper
# start a second one on top of this unit. See awww.service for that failure.
# See ~/Documents/docs/hyprland-wallpaper-waypaper-setup.md



#############################
### ENVIRONMENT VARIABLES ###
#############################

# See https://wiki.hyprland.org/Configuring/Environment-variables/

env = XCURSOR_SIZE,24
env = HYPRCURSOR_SIZE,24

# Make Qt apps follow the GTK theme, so they flip with toggle-color-scheme like
# everything else. The qgtk3 platform theme plugin ships with Fedora's qt5/qt6
# base packages (libqgtk3.so) — no qt5ct/qt6ct/Kvantum needed. Mirrored in the
# niri session's `environment` block; ~/.config/environment.d/ would NOT work,
# since Hyprland is started by GDM rather than by systemd.
env = QT_QPA_PLATFORMTHEME,gtk3

# NB: a DisplayLink dock (Dell D6000) needs an AQ_DRM_DEVICES line here so
# aquamarine enumerates the evdi DRM nodes — but ONLY set it together with
# loading evdi at boot, and test it before relying on it. Deliberately left
# out: the dock's monitor works without it (Hyprland hot-adds the evdi device
# via udev), and evdi takes card0, so a wrong value risks a broken session at
# login.
#
# ⚠️ The DisplayLink stack was REMOVED on 2026-08-12 — `modinfo evdi` now reports
# no such module, so nothing here is live. It went because evdi was the one
# variable unique to the boot that deadlocked the compositor, and a resident
# evdi holding imported amdgpu buffers could not be ruled out. Note that
# `rm /etc/modules-load.d/evdi.conf` does NOT unload a running module — that is
# what made the question unanswerable at the time.
#
# Revival recipe (and the evdi caveat above, which still applies) is kept in
# ~/Documents/docs/displaylink-dock-d6000-hyprland.md
# Why it was removed: ~/Documents/docs/hyprland-freeze-atomic-commit-deadlock.md


#####################
### LOOK AND FEEL ###
#####################

# Refer to https://wiki.hyprland.org/Configuring/Variables/

# https://wiki.hyprland.org/Configuring/Variables/#general
general {
    gaps_in = 3
    gaps_out = 8

    border_size = 2

    # https://wiki.hyprland.org/Configuring/Variables/#variable-types for info about colors
    # Sun/SGI/AIX-era workstation palette: dusty steel-blue → desaturated teal
    col.active_border = rgba(6b7a99ee) rgba(5c9090ee) 45deg
    col.inactive_border = rgba(44444488)

    # Set to true enable resizing windows by clicking and dragging on borders and gaps
    resize_on_border = true
    extend_border_grab_area = 15

    # Please see https://wiki.hyprland.org/Configuring/Tearing/ before you turn this on
    allow_tearing = false

    layout = dwindle
}

# https://wiki.hyprland.org/Configuring/Variables/#decoration
decoration {
    rounding = 4

    # Change transparency of focused and unfocused windows
    active_opacity = 1.0
    inactive_opacity = 1.0

    shadow {
        enabled = true
        range = 4
        render_power = 3
        color = rgba(1a1a1aee)
    }

    # https://wiki.hyprland.org/Configuring/Variables/#blur
    blur {
        enabled = true
        size = 3
        passes = 1

        vibrancy = 0.1696
    }
}

# https://wiki.hyprland.org/Configuring/Variables/#group
# Tabbed window groups (Super+T). SGI/Sun hard-edge workstation styling:
# square boxy tabs, steel-blue→teal gradient on the active tab, a crisp 3px
# indicator line, monospace labels, zero rounding everywhere.
# col.active / col.inactive / text_color are re-applied per color-scheme by
# toggle-color-scheme so the tab strip flips with dark/light like the borders.
group {
    # Border of the grouped (parent) window — mirrors the general border palette.
    col.border_active = rgba(6b7a99ee) rgba(5c9090ee) 45deg
    col.border_inactive = rgba(44444488)

    groupbar {
        enabled = true
        font_family = monospace
        font_size = 10
        height = 18
        indicator_height = 3      # crisp accent line under the active tab
        gradients = true
        render_titles = true
        scrolling = true          # scroll over the bar to cycle tabs

        # Hard edges — no rounding, no gaps. Pure boxy workstation look.
        rounding = 0
        gradient_rounding = 0
        gaps_in = 0
        gaps_out = 0

        text_color = rgba(e5e9f0ff)
        col.active = rgba(6b7a99ee) rgba(5c9090ee) 45deg
        col.inactive = rgba(2e3440dd)
    }
}



# https://wiki.hyprland.org/Configuring/Variables/#animations
animations {
    enabled = yes, please :)

    # Default animations, see https://wiki.hyprland.org/Configuring/Animations/ for more

    bezier = easeOutQuint,0.23,1,0.32,1
    bezier = easeInOutCubic,0.65,0.05,0.36,1
    bezier = linear,0,0,1,1
    bezier = almostLinear,0.5,0.5,0.75,1.0
    bezier = quick,0.15,0,0.1,1

    animation = global, 1, 10, default
    animation = border, 1, 5.39, easeOutQuint
    animation = windows, 1, 4.79, easeOutQuint
    animation = windowsIn, 1, 4.1, easeOutQuint, popin 87%
    animation = windowsOut, 1, 1.49, linear, popin 87%
    animation = fadeIn, 1, 1.73, almostLinear
    animation = fadeOut, 1, 1.46, almostLinear
    animation = fade, 1, 3.03, quick
    animation = layers, 1, 3.81, easeOutQuint
    animation = layersIn, 1, 4, easeOutQuint, fade
    animation = layersOut, 1, 1.5, linear, fade
    animation = fadeLayersIn, 1, 1.79, almostLinear
    animation = fadeLayersOut, 1, 1.39, almostLinear
    animation = workspaces, 1, 1.94, almostLinear, fade
    animation = workspacesIn, 1, 1.21, almostLinear, fade
    animation = workspacesOut, 1, 1.94, almostLinear, fade
}

# Ref https://wiki.hyprland.org/Configuring/Workspace-Rules/
# "Smart gaps" / "No gaps when only"
# uncomment all if you wish to use that.
# NOTE: single-window centering is instead handled by reading-column.py
# (exec-once above) because it needs per-monitor computed margins, which these
# fixed-px w[tv1] rules can't express. Don't enable both.
# workspace = w[tv1], gapsout:0, gapsin:0
# workspace = f[1], gapsout:0, gapsin:0
# windowrulev2 = bordersize 0, floating:0, onworkspace:w[tv1]
# windowrulev2 = rounding 0, floating:0, onworkspace:w[tv1]
# windowrulev2 = bordersize 0, floating:0, onworkspace:f[1]
# windowrulev2 = rounding 0, floating:0, onworkspace:f[1]

# See https://wiki.hyprland.org/Configuring/Dwindle-Layout/ for more
dwindle {
    # NB: `pseudotile` was removed in Hyprland 0.56 — pseudotiling no longer has
    # a master switch, the `pseudo` dispatcher (mainMod + P below) just works.
    preserve_split = true # You probably want this

    # Keep new windows splitting side-by-side on the ultrawide.
    #
    # Dwindle decides the split from the layout box: it stacks top/bottom as soon
    # as `box.w <= box.h * split_width_multiplier`. Since 0.56 reworked the layout
    # engine, gaps_out (including a per-workspace `gapsout` rule) is subtracted
    # from that box *before* the decision — it used to be applied per-window
    # afterwards, leaving the box full-width. So reading-column.py's
    # `gapsout: 24 1095 24 1095` makes the box ~1250x1366 on the 3440x1440
    # screen — taller than wide — and the second window stacked full-width /
    # half-height instead of splitting left/right.
    #
    # 0.85 keeps the 1250px auto column (ratio ~0.91) on the side-by-side side of
    # the threshold. preserve_split=true freezes the orientation chosen at open
    # time, so this is decided once per pair. The narrow 800px Super+C reading
    # column (ratio ~0.59) is still below the threshold and will stack — fix that
    # case by hand with the togglesplit bind below.
    split_width_multiplier = 0.85
}

# See https://wiki.hyprland.org/Configuring/Master-Layout/ for more
master {
    new_status = master
}

# hyprtasking (workspace overview, Super+Tab — see the exec-once above).
# `plugin` is a hyprlang special category registered with missing-key tolerance
# (legacy/ConfigManager.cpp: addSpecialCategory("plugin", {nullptr, true})), so
# this block is inert rather than an error during the window between config parse
# and the plugin actually loading from exec-once.
plugin {
    hyprtasking {
        layout = grid

        # Type a workspace's label (1-9, 0, then a-z) to jump straight to it,
        # instead of aiming with the mouse.
        jump {
            enabled = true
        }
    }
}

# https://wiki.hyprland.org/Configuring/Variables/#misc
misc {
    force_default_wallpaper = -1 # Set to 0 or 1 to disable the anime mascot wallpapers
    disable_hyprland_logo = false # If true disables the random hyprland logo / anime girl background. :(
}


#############
### INPUT ###
#############

# https://wiki.hyprland.org/Configuring/Variables/#input
input {
    kb_layout = eu
    kb_variant =
    kb_model =
    kb_options = ctrl:nocaps
    kb_rules =

    follow_mouse = 1

    repeat_rate = 50      # keys per second while held (default 25)
    repeat_delay = 250    # ms before repeat kicks in (default 600)

    sensitivity = 0 # -1.0 - 1.0, 0 means no modification.

    natural_scroll = true

    scroll_factor = 0.5   # G502 X PLUS hi-res wheel scrolls too fast at 1.0

    touchpad {
        natural_scroll = true
    }

    # Wacom Intuos BT M via OpenTabletDriver (see bootstrap/SETUP.md § 2c).
    # Binds the pen to the laptop panel; without it Hyprland spreads the pen
    # across the whole desktop layout, which is both distorted and partly dead
    # (the layout is L-shaped, so the area below the ultrawide's right half maps
    # to no screen at all).
    #
    # ⚠️  This MUST live here as the global input:tablet:output. Setting
    # `output = eDP-1` inside a `device { name = opentabletdriver-... }` block
    # does NOT work on 0.56 — it is accepted with an empty `hyprctl
    # configerrors` and then silently ignored. Only the pen behaves; nothing
    # reports a problem. Verify with `hyprctl getoption input:tablet:output`
    # (must say `set: true`), never by the absence of config errors.
    # There is only one tablet — the kernel wacom device is muted by
    # /etc/udev/rules.d/70-opentabletdriver.rules — so global is also correct.
    tablet {
        output = eDP-1
    }
}

{{ if eq .machineClass "laptop" -}}
# Per-device input config
# See https://wiki.hyprland.org/Configuring/Keywords/#per-device-input-configs for more
device {
    name = logitech-g502-x-plus-1
    accel_profile = flat
    sensitivity = -0.5
}

device {
    name = steelseries-steelseries-rival-3
    accel_profile = flat
    sensitivity = -0.5
}

{{ end -}}
###################
### KEYBINDINGS ###
###################

# See https://wiki.hyprland.org/Configuring/Keywords/
$mainMod = SUPER # Sets "Windows" key as main modifier

# Core
bind = $mainMod, Return, exec, $terminal
bind = $mainMod, D, exec, $menu
bind = $mainMod, Space, exec, $menu       # macOS Spotlight-style launcher trigger
# Workspace overview (hyprtasking): Tab alone = the monitor under the cursor,
# +SHIFT = every monitor at once. Same key closes it again. Inside the overview:
# right-click switches, left-drag moves a window, 1-9/0/a-z jump by label.
# NB: no `, escape` bind (which the plugin's README suggests) — a bound key is
# consumed by the compositor whether or not the dispatcher acts, so a global
# Escape bind would stop emacs/evil and terminals from ever seeing Escape.
bind = $mainMod, Tab, hyprtasking:toggle, cursor
bind = $mainMod SHIFT, Tab, hyprtasking:toggle, all

# kando pie menu — moved off Super+Tab for hyprtasking; keeps the launchers
# together on Space ($menu on Super+Space, kando on Super+SHIFT+Space).
bind = $mainMod SHIFT, Space, exec, kando -m "Example Menu"
bind = $mainMod, Q, killactive,
# Session menu (lock / log out / suspend / hibernate / reboot / shut down).
# NOT `exit`, which this used to be: this session runs under uwsm, whose README
# says in as many words not to use the compositor's native exit mechanism --
# it yanks the compositor out from under its clients and skips the ordered unit
# deactivation. session-menu resolves the right teardown at runtime instead
# (uwsm stop here, niri IPC there, loginctl terminate-session otherwise), so the
# same key is correct in the default, DMS and niri sessions. The menu is also
# the confirmation step this key never had.
bind = $mainMod SHIFT, E, exec, ~/.local/bin/session-menu
bind = $mainMod, E, exec, $fileManager
bind = $mainMod, W, exec, waypaper          # wallpaper picker GUI (awww backend)
bind = $mainMod, F, fullscreen,
bind = $mainMod, M, fullscreen, 1
bind = $mainMod, V, togglefloating,
bind = $mainMod, P, pseudo, # dwindle
bind = $mainMod, Escape, exec, loginctl lock-session
bind = $mainMod SHIFT, Escape, exec, systemctl suspend
# Packing away for the night or a weekend. The lid only ever suspends (~1 W, so
# a closed machine still goes flat in under three days on this s2idle-only
# laptop) -- hibernating is a deliberate act, taken while watching it power off.
# It is deliberately NOT automatic: on 2026-08-12 an unattended timed hibernate
# wedged inside a closed backpack and cooked the machine for 44 minutes.
bind = $mainMod CTRL, Escape, exec, ~/.local/bin/hibernate-now
bind = $mainMod SHIFT, T, exec, ~/.local/bin/toggle-color-scheme
bind = $mainMod, G, exec, ~/.local/bin/term-project   # fuzzy-pick a repo -> ghostty with project banner
bind = $mainMod, C, exec, ~/.config/hypr/reading-column.py toggle   # toggle narrow reading column on focused workspace

# Focus (vim hjkl)
bind = $mainMod, H, movefocus, l
bind = $mainMod, J, movefocus, d
bind = $mainMod, K, movefocus, u
bind = $mainMod, L, movefocus, r

# Switch between current and last focused window
bind = $mainMod, grave, focuscurrentorlast

# Split orientation escape hatch. Super+O flips the focused pair between
# side-by-side and stacked, Super+SHIFT+O swaps the two windows within the split.
# NB: the standalone `togglesplit` dispatcher is gone in 0.56 (like `pseudotile`)
# — it lives on as `layoutmsg togglesplit`, so a bare `bind = ..., togglesplit`
# is silently dead config. See also `layoutmsg preselect l|r|u|d`, which aims the
# *next* window (one-shot unless dwindle:permanent_direction_override is on).
bind = $mainMod, O, layoutmsg, togglesplit
bind = $mainMod SHIFT, O, layoutmsg, swapsplit

# Swap window with neighbor
bind = $mainMod SHIFT, H, swapwindow, l
bind = $mainMod SHIFT, J, swapwindow, d
bind = $mainMod SHIFT, K, swapwindow, u
bind = $mainMod SHIFT, L, swapwindow, r

# Resize submap: Super+R enters, hjkl resize, Escape/Return exits
bind = $mainMod, R, submap, resize
submap = resize
binde = , H, resizeactive, -40 0
binde = , J, resizeactive, 0 40
binde = , K, resizeactive, 0 -40
binde = , L, resizeactive, 40 0
bind = , escape, submap, reset
bind = , return, submap, reset
submap = reset

# Switch workspaces with mainMod + [0-9]
bind = $mainMod, 1, workspace, 1
bind = $mainMod, 2, workspace, 2
bind = $mainMod, 3, workspace, 3
bind = $mainMod, 4, workspace, 4
bind = $mainMod, 5, workspace, 5
bind = $mainMod, 6, workspace, 6
bind = $mainMod, 7, workspace, 7
bind = $mainMod, 8, workspace, 8
bind = $mainMod, 9, workspace, 9
bind = $mainMod, 0, workspace, 10

# Move active window to a workspace with mainMod + SHIFT + [0-9]
bind = $mainMod SHIFT, 1, movetoworkspace, 1
bind = $mainMod SHIFT, 2, movetoworkspace, 2
bind = $mainMod SHIFT, 3, movetoworkspace, 3
bind = $mainMod SHIFT, 4, movetoworkspace, 4
bind = $mainMod SHIFT, 5, movetoworkspace, 5
bind = $mainMod SHIFT, 6, movetoworkspace, 6
bind = $mainMod SHIFT, 7, movetoworkspace, 7
bind = $mainMod SHIFT, 8, movetoworkspace, 8
bind = $mainMod SHIFT, 9, movetoworkspace, 9
bind = $mainMod SHIFT, 0, movetoworkspace, 10

# Example special workspace (scratchpad)
bind = $mainMod, S, togglespecialworkspace, magic
bind = $mainMod SHIFT, S, movetoworkspace, special:magic

# Scroll through existing workspaces with mainMod + scroll
bind = $mainMod, mouse_down, workspace, e+1
bind = $mainMod, mouse_up, workspace, e-1

# Move/resize windows with mainMod + LMB/RMB and dragging
bindm = $mainMod, mouse:272, movewindow
bindm = $mainMod, mouse:273, resizewindow

# Toggle grouped/tabbed state
bind = $mainMod, T, togglegroup

# Change active tab (next/previous)
bind = $mainMod, bracketright, changegroupactive, f
bind = $mainMod, bracketleft, changegroupactive, b

# Move window into group (CTRL = stronger than SHIFT swap)
bind = $mainMod CTRL, H, moveintogroup, l
bind = $mainMod CTRL, J, moveintogroup, d
bind = $mainMod CTRL, K, moveintogroup, u
bind = $mainMod CTRL, L, moveintogroup, r

# Screenshots (grim + slurp + wl-clipboard)
bind = , Print, exec, grim -g "$(slurp)" - | wl-copy
bind = SHIFT, Print, exec, grim -g "$(slurp)" ~/Pictures/$(date +%F-%H%M%S).png
bind = $mainMod, Print, exec, grim ~/Pictures/$(date +%F-%H%M%S).png

# Laptop multimedia keys for volume and LCD brightness
# Using swayosd for nice on-screen notifications
# Volume controls - show OSD on focused monitor
bindel = ,XF86AudioRaiseVolume, exec, swayosd-client --monitor "$(hyprctl monitors -j | jq -r '.[] | select(.focused == true).name')" --output-volume +5
bindel = ,XF86AudioLowerVolume, exec, swayosd-client --monitor "$(hyprctl monitors -j | jq -r '.[] | select(.focused == true).name')" --output-volume -5
bindel = ,XF86AudioMute, exec, swayosd-client --monitor "$(hyprctl monitors -j | jq -r '.[] | select(.focused == true).name')" --output-volume mute-toggle
bindel = ,XF86AudioMicMute, exec, swayosd-client --monitor "$(hyprctl monitors -j | jq -r '.[] | select(.focused == true).name')" --input-volume mute-toggle
# Brightness controls - show OSD on focused monitor
bindel = ,XF86MonBrightnessUp, exec, swayosd-client --monitor "$(hyprctl monitors -j | jq -r '.[] | select(.focused == true).name')" --brightness +10
bindel = ,XF86MonBrightnessDown, exec, swayosd-client --monitor "$(hyprctl monitors -j | jq -r '.[] | select(.focused == true).name')" --brightness -10

# Requires playerctl
bindl = , XF86AudioNext, exec, playerctl next
bindl = , XF86AudioPause, exec, playerctl play-pause
bindl = , XF86AudioPlay, exec, playerctl play-pause
bindl = , XF86AudioPrev, exec, playerctl previous

##############################
### WINDOWS AND WORKSPACES ###
##############################

# See https://wiki.hyprland.org/Configuring/Window-Rules/ for more
# See https://wiki.hyprland.org/Configuring/Workspace-Rules/ for workspace rules

# Workspace rules - configured dynamically via setup_workspaces.sh
# based on connected monitors (HDMI-A-1 presence)

# Window rule syntax (Hyprland >= 0.56):
#   windowrule = <effect> <value>, match:<prop> <value>, ...
# `windowrulev2` is GONE — its handler only raises a deprecation error, so any
# such rule is silently never applied. Three things changed at once:
#   - matchers are `match:prop value` (prefix + space), not `prop:value`
#   - EVERY field needs a value, so bare `float` / `pin` must be `float true`
#   - effects are snake_case: suppressevent→suppress_event, nofocus→no_focus,
#     noblur→no_blur, noanim→no_anim, noinitialfocus→no_initial_focus,
#     and noborder is gone entirely → use `border_size 0`
# Example:
# windowrule = float true, match:class ^(kitty)$, match:title ^(kitty)$

# Ignore maximize requests from apps. You'll probably like this.
windowrule = suppress_event maximize, match:class .*

# Fix some dragging issues with XWayland
windowrule = no_focus true, match:class ^$, match:title ^$, match:xwayland true, match:float true, match:fullscreen false, match:pin false

# Chromium notification popups — no app_id or title set by the browser
windowrule = float true, match:class ^$, match:title ^$, match:xwayland false
windowrule = pin true, match:class ^$, match:title ^$, match:xwayland false
windowrule = move 100%-w-12 40, match:class ^$, match:title ^$, match:xwayland false
windowrule = no_focus true, match:class ^$, match:title ^$, match:xwayland false

# Kando radial menu — force fit to focused monitor (cursor's monitor via follow_mouse)
windowrule = float true, match:class ^(menu\.kando\.Kando)$, match:title ^(Kando Menu)$
windowrule = size 100% 100%, match:class ^(menu\.kando\.Kando)$, match:title ^(Kando Menu)$
windowrule = move 0 0, match:class ^(menu\.kando\.Kando)$, match:title ^(Kando Menu)$
windowrule = pin true, match:class ^(menu\.kando\.Kando)$, match:title ^(Kando Menu)$
windowrule = border_size 0, match:class ^(menu\.kando\.Kando)$, match:title ^(Kando Menu)$
windowrule = no_blur true, match:class ^(menu\.kando\.Kando)$, match:title ^(Kando Menu)$
windowrule = no_anim true, match:class ^(menu\.kando\.Kando)$, match:title ^(Kando Menu)$
windowrule = no_initial_focus true, match:class ^(menu\.kando\.Kando)$, match:title ^(Kando Menu)$
windowrule = rounding 0, match:class ^(menu\.kando\.Kando)$, match:title ^(Kando Menu)$

# Kando settings: half-size and centered.
# NB: was `monitor:1` (HDMI only) — 0.56 removed the `monitor:` MATCHER (monitor
# is now only an effect), so this applies on every monitor. size is relative to
# the monitor, so the result is the same shape on the internal display too.
windowrule = float true, match:class ^(menu\.kando\.Kando)$, match:title ^(Kando Settings)$
windowrule = size 60% 70%, match:class ^(menu\.kando\.Kando)$, match:title ^(Kando Settings)$
windowrule = center true, match:class ^(menu\.kando\.Kando)$, match:title ^(Kando Settings)$
