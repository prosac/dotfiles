{{/* Rendered by chezmoi from ~/.config/chezmoi/chezmoi.toml (generated by
     `chezmoi init`, NOT in this repo -- the repo is public).

     This is sandy's per-machine half. Workspace profiles in
     ~/.config/sandy/workspaces/ name things by role -- "the ssh agent", "the
     password manager" -- and this says what they are here, so the same
     workspace profile applies unchanged on the other machine.

     `dig` rather than a bare `.reposRoot`: a key added to .chezmoi.toml.tmpl
     does not reach a machine until `chezmoi init` is re-run there, and a bare
     reference would break `chezmoi apply` everywhere until it was. */ -}}
{{- $reposRoot := dig "reposRoot" "~/repos" . -}}
{{- $workspace := dig "sandyWorkspace" "" . -}}
# Managed by chezmoi -- edit via `chezmoi edit ~/.config/sandy/config.toml`.
repos_root = {{ $reposRoot | quote }}
{{ if $workspace }}default_workspace = {{ $workspace | quote }}
{{ end }}
[identity]
{{- if eq .passwordManager "1password" }}
# Forwarded, never copied: signing and GitLab auth happen on the host, behind
# 1Password's own approval prompt. The signing key in ~/.gitconfig is a public
# key string, so `ssh-keygen -Y sign` inside reaches the same agent -- no
# 1Password binary is needed in the sandbox.
ssh_agent_socket = "~/.1password/agent.sock"
{{- else if eq .passwordManager "bitwarden" }}
ssh_agent_socket = "~/.bitwarden-ssh-agent.sock"
{{- end }}
git_config = ["~/.gitconfig", "~/.config/git"]

[secrets]
{{- if eq .passwordManager "1password" }}
# `op` inside the sandbox is a shim that forwards lookups to a broker sandy
# runs on the host. The real CLI cannot work in there: the desktop app rejects
# a caller inside a mount+pid namespace (measured -- it resets the connection
# on the first native-messaging request). So the vault, its unlock state and
# its prompts stay here, and one resolved value crosses per explicit request.
provider = "op"
{{- else if eq .passwordManager "bitwarden" }}
provider = "bw"
{{- end }}
