#!/usr/bin/env bash
# Create an hourly read-only btrfs snapshot of /home, then trim retention.
# Requires /etc/sudoers.d/dotsnap (see bootstrap/SETUP.md).
set -euo pipefail

ROOT=/home
SNAPDIR=/home/.snapshots/hourly
RETAIN=${DOTSNAP_RETAIN:-168}    # ~7 days of hourly

# Not every machine running these dotfiles has a btrfs /home -- a long-lived
# desktop upgraded across many Fedora releases can easily still be on ext4.
#
# Detected at RUNTIME rather than prompted for at `chezmoi init`: the filesystem
# is a property of the disk, not a choice about the machine, so asking would add
# a question whose answer is already sitting in `findmnt`. It also means an
# existing machine that is later reinstalled onto btrfs starts snapshotting with
# no config change.
#
# ⚠️ Exit 0, not 1. dotsnap.service carries OnFailure=notify-failure@%n.service
# and the timer fires hourly, so failing here would put a desktop notification
# on screen every hour forever on any non-btrfs machine. `ConditionPathIsMountPoint=/home`
# in the unit does NOT cover this: /home is very often its own mount on ext4 too.
fstype=$(findmnt -no FSTYPE --target "$ROOT" 2>/dev/null || true)
if [ "$fstype" != "btrfs" ]; then
  echo "dotsnap: $ROOT is ${fstype:-unknown}, not btrfs — nothing to snapshot."
  exit 0
fi

stamp=$(date +%Y-%m-%d-%H%M)
target="$SNAPDIR/$stamp"

if [ -e "$target" ]; then
  echo "dotsnap: $target already exists, skipping" >&2
  exit 0
fi

sudo -n /usr/sbin/btrfs subvolume snapshot -r "$ROOT" "$target" >/dev/null
echo "dotsnap: created $target"

# Trim oldest beyond retention. Names sort chronologically (YYYY-MM-DD-HHMM).
mapfile -t snaps < <(ls -1 "$SNAPDIR" 2>/dev/null | sort)
count=${#snaps[@]}
if (( count > RETAIN )); then
  for (( i=0; i < count - RETAIN; i++ )); do
    sudo -n /usr/sbin/btrfs subvolume delete "$SNAPDIR/${snaps[$i]}" >/dev/null
    echo "dotsnap: pruned ${snaps[$i]}"
  done
fi
