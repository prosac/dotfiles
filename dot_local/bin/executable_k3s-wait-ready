#!/usr/bin/env python3
"""Block until the rootless k3s node is actually Ready, then exit.

`k3s-rootless.service` is `Type=simple`, so systemd reports it active the instant the process
forks — while the API server still needs the better part of a minute. Anything that starts the
unit and immediately uses the cluster is therefore racing it, and the failure surfaces as a
connection refused from `kubectl` rather than as "not ready yet".

This is the ExecStart of `k3s-rootless-ready.service`, a oneshot that Requires+After the server.
Keeping it in its own unit rather than an `ExecStartPost=` on the server is deliberate: the server
sets `TimeoutSec=0` and `Restart=always`, so a readiness check wired into it would either hang
`systemctl start` forever or drive a restart loop. A separate unit can fail honestly and leave a
running cluster alone.

Environment:
    KUBECONFIG            defaults to ~/.kube/k3s.yaml — NOT ~/.kube/config, which holds the real
                          cvh-stage and cvh-production contexts and must never be merged with this
    K3S_READY_TIMEOUT     seconds to wait before giving up (default 180)
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

DEFAULT_TIMEOUT_SECONDS = 180
POLL_SECONDS = 2

KUBECONFIG = Path(os.environ.get("KUBECONFIG") or Path.home() / ".kube" / "k3s.yaml")


def kubectl_binary() -> str:
    """Systemd units run with a restricted PATH, so look where the binary actually is first."""
    local = Path.home() / ".local" / "bin" / "kubectl"
    if local.is_file():
        return str(local)
    found = shutil.which("kubectl")
    if not found:
        sys.exit("k3s-wait-ready: kubectl not found in ~/.local/bin or on PATH")
    return found


def ready_nodes(kubectl: str) -> tuple[int, int]:
    """(ready, total). A non-zero exit or unparseable output means 'not up yet', not an error."""
    try:
        result = subprocess.run(
            [kubectl, "get", "nodes", "-o", "json"],
            capture_output=True,
            text=True,
            check=False,
            timeout=15,
            env={**os.environ, "KUBECONFIG": str(KUBECONFIG)},
        )
    except subprocess.TimeoutExpired:
        return 0, 0
    if result.returncode != 0:
        return 0, 0
    try:
        nodes = json.loads(result.stdout).get("items", [])
    except json.JSONDecodeError:
        return 0, 0
    ready = sum(
        1
        for node in nodes
        for condition in node.get("status", {}).get("conditions", [])
        if condition.get("type") == "Ready" and condition.get("status") == "True"
    )
    return ready, len(nodes)


def main() -> None:
    timeout = int(os.environ.get("K3S_READY_TIMEOUT", DEFAULT_TIMEOUT_SECONDS))
    kubectl = kubectl_binary()
    deadline = time.monotonic() + timeout

    while time.monotonic() < deadline:
        if KUBECONFIG.is_file() and os.access(KUBECONFIG, os.R_OK):
            ready, total = ready_nodes(kubectl)
            if ready and ready == total:
                print(f"k3s-wait-ready: {ready}/{total} node(s) Ready", file=sys.stderr)
                return
        time.sleep(POLL_SECONDS)

    if not KUBECONFIG.is_file():
        sys.exit(f"k3s-wait-ready: {KUBECONFIG} never appeared within {timeout}s")
    ready, total = ready_nodes(kubectl)
    sys.exit(f"k3s-wait-ready: only {ready}/{total} node(s) Ready after {timeout}s")


if __name__ == "__main__":
    main()
