#!/usr/bin/env python3
"""PreToolUse hook (Bash): deny `git commit` of untrimmed comments.

Fires when the diff adds >= MIN_LINES comment lines (every non-blank line in doc files)
and the transcript shows no `cvh-workflows:concise` run after the last Edit/Write that
added comments to a committed file.

Blind spot: Bash writes (heredoc, sed) aren't seen as edits, so an earlier run clears them.
`CONCISE_SKIP=1 git commit …` bypasses it, for when the user said not to trim.
Stdlib only; fails open.
"""
import json
import os
import re
import subprocess
import sys

MIN_LINES = 3
CONCISE_NAMES = {"cvh-workflows:concise", "concise"}
DOC_EXT = (".md", ".mdx", ".rst", ".adoc")
SKIP_PATH = re.compile(
    r"(^|/)(node_modules|vendor|\.repos)/|\.lock$|(^|/)(package-lock\.json|pnpm-lock\.yaml|go\.sum)$"
)
COMMENT = re.compile(r"""^(#(?!!)|//|/\*|\*|--\s|;+\s|\"\"\"|'''|<!--|\{\{-?\s*/\*)""")
TRAILING = re.compile(r"\s(#|//)\s+\w")
COMMIT = re.compile(
    r"(?:^|[;&|(]\s*)((?:\w+=\S*\s+)*)(?:rtk\s+)?git\s+((?:-[Cc]\s+\S+\s+)*)commit\b([^;&|]*)"
)
CD = re.compile(r"(?:^|[;&|]\s*)cd\s+(\S+)")


def comment_lines(path: str, lines: list[str]) -> int:
    if SKIP_PATH.search(path):
        return 0
    if path.endswith(DOC_EXT):
        return sum(1 for l in lines if l.strip())
    n, in_doc = 0, False
    for line in lines:
        s = line.strip()
        quotes = s.count('"""') + s.count("'''")
        if in_doc or COMMENT.match(s) or TRAILING.search(line):
            n += 1
        if quotes % 2:
            in_doc = not in_doc
    return n


def added_by_file(diff: str) -> dict[str, list[str]]:
    files: dict[str, list[str]] = {}
    current = None
    for line in diff.splitlines():
        if line.startswith("+++ "):
            current = line[6:] if line.startswith("+++ b/") else None
            if current:
                files.setdefault(current, [])
        elif current and line.startswith("+"):
            files[current].append(line[1:])
    return files


def edit_text(name: str, inp: dict) -> list[str]:
    if name == "Write":
        return inp.get("content", "").splitlines()
    if name == "Edit":
        old = set(inp.get("old_string", "").splitlines())
        return [l for l in inp.get("new_string", "").splitlines() if l not in old]
    if name == "MultiEdit":
        out = []
        for e in inp.get("edits", []):
            out += edit_text("Edit", e)
        return out
    return []


def concise_cleared(transcript: str, staged_abs: set[str]) -> bool:
    last_concise = last_edit = -1
    with open(transcript) as fh:
        for i, raw in enumerate(fh):
            try:
                entry = json.loads(raw)
            except ValueError:
                continue
            if entry.get("isSidechain") or entry.get("type") != "assistant":
                continue
            content = (entry.get("message") or {}).get("content")
            if not isinstance(content, list):
                continue
            for block in content:
                if block.get("type") != "tool_use":
                    continue
                name, inp = block.get("name"), block.get("input") or {}
                if (name in ("Agent", "Task") and inp.get("subagent_type") in CONCISE_NAMES) or (
                    name == "Skill" and inp.get("skill") in CONCISE_NAMES
                ):
                    last_concise = i
                path = inp.get("file_path", "")
                if path in staged_abs and comment_lines(path, edit_text(name, inp)):
                    last_edit = i
    return last_concise >= 0 and last_concise > last_edit


def git(repo: str, *args: str) -> str:
    return subprocess.run(
        ["git", "-C", repo, *args], capture_output=True, text=True, check=True, timeout=10
    ).stdout


def main() -> int:
    data = json.load(sys.stdin)
    command = (data.get("tool_input") or {}).get("command", "")
    match = COMMIT.search(command)
    if not match or "CONCISE_SKIP=1" in match.group(1):
        return 0
    repo = data.get("cwd") or os.getcwd()
    cds = CD.findall(command[: match.start()])
    if cds:
        repo = os.path.join(repo, os.path.expanduser(cds[-1]))
    c_dirs = re.findall(r"-C\s+(\S+)", match.group(2))
    if c_dirs:
        repo = os.path.join(repo, os.path.expanduser(c_dirs[-1]))
    args = match.group(3)
    all_flag = re.search(r"(^|\s)(--all|-[a-zA-Z]*a[a-zA-Z]*)(\s|$)", args)
    diff = git(repo, "diff", "HEAD" if all_flag else "--cached", "--no-color", "--no-ext-diff")
    files = {p: comment_lines(p, ls) for p, ls in added_by_file(diff).items()}
    total = sum(files.values())
    if total < MIN_LINES:
        return 0
    top = git(repo, "rev-parse", "--show-toplevel").strip()
    staged_abs = {os.path.join(top, p) for p in files}
    transcript = data.get("transcript_path")
    if transcript and os.path.exists(transcript) and concise_cleared(transcript, staged_abs):
        return 0
    worst = ", ".join(f"{p} ({n})" for p, n in sorted(files.items(), key=lambda x: -x[1]) if n)
    reason = (
        f"This commit adds {total} comment/doc lines ({worst}) that cvh-workflows:concise has not "
        "trimmed since they were last edited. Run the `cvh-workflows:concise` skill on the pending "
        "diff now (if the changes are already committed elsewhere, give it the file paths), "
        "re-stage its edits, then retry the commit. Only if the user explicitly said not to trim "
        "these, prefix the command with CONCISE_SKIP=1."
    )
    print(
        json.dumps(
            {
                "hookSpecificOutput": {
                    "hookEventName": "PreToolUse",
                    "permissionDecision": "deny",
                    "permissionDecisionReason": reason,
                }
            }
        )
    )
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:  # the guard must never block on its own failure
        print(f"concise-guard-claude: {exc}", file=sys.stderr)
        sys.exit(0)
