#!/usr/bin/env python3
"""term-ident — give a ghostty window a stable visual identity from a seed.

A seed string is hashed to a hue, which drives two coordinated cues so that
parallel terminals are recognizable at a glance:

  - a subtle, theme-aware BACKGROUND tint   (OSC 11 -> the controlling tty)
  - a vivid per-window BORDER gradient        (hyprctl dispatch setprop)

Border is the strong, theme-independent cue; the bg tint is the peripheral
bonus. Degrades to a no-op outside Hyprland / when not running under ghostty.

Both cues are computed against the ACTIVE color scheme, so a dark<->light flip
invalidates them — an OSC-11 background in particular overrides ghostty's own
theme background and will not recompute itself. Every applied seed is therefore
recorded under $XDG_RUNTIME_DIR/term-ident/, and `term-ident retint` replays
those records against the current scheme. toggle-color-scheme calls it on every
flip.

Usage:
  term-ident project [dir]   seed from the git toplevel of dir (default $PWD);
                             resets to defaults when dir is not in a repo
  term-ident seed <string>   seed from an arbitrary string
  term-ident ensure <str>    apply <str> only if not already shown under the
                             current scheme — the cheap re-assert for a session
                             with no shell prompt to self-heal from
  term-ident reset           clear tint + border (back to theme defaults)
  term-ident retint          re-apply every recorded session for the current
                             scheme; prunes records of dead sessions
  term-ident identity <str>  print {glyph, accent, scheme} JSON for a seed — used
                             by the Claude statusline so its marker matches the
                             border. The accent is scheme-dependent, the glyph is
                             not, so a stored accent goes stale on a flip and the
                             statusline re-derives it from the seed.

Env:
  TERM_IDENT_TTY   tty to receive OSC sequences (default /dev/tty)
  TERM_IDENT_PID   pid to start the ghostty ppid-chain walk from (default self);
                   lets `retint` resolve a window it is not a descendant of
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
import zlib

TTY = os.environ.get("TERM_IDENT_TTY", "/dev/tty")

# Per-session records, keyed by tty. Shares the directory term-ident-claude uses
# for its per-session statusline files; tmpfs, so it clears itself on logout.
STATE_DIR = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "term-ident")

# One-word marker of the active scheme, written by toggle-color-scheme on every
# flip. A cache, never the source of truth — see cached_scheme().
SCHEME_MARKER = os.path.join(STATE_DIR, "scheme")

# Accents, per scheme. Every tint derives from one of these, so colors always sit
# on-theme; backgrounds are the accent blended into the theme background, borders
# are the accent itself. Six slots, index-aligned across the two schemes.
#
# The two lists are DIFFERENT HUES on purpose — reusing the dark accents on a
# near-white base does not work. Blending any of them into #f9f9f9 crushes them
# toward the same pale wash: the shared palette measured a closest pair of only
# ΔE 4.6 in light (median 9.0) against 7.2/15.5 in dark, i.e. half the separation,
# which is the whole point of the tint. Light therefore widens the wheel past the
# cool run — the "no green/amber" rule was a dark-background constraint (they went
# muddy against #282c34), and on white they are simply pale mint and sand.
# Measured on the light set below: closest pair ΔE 12.8, median 16.8, every tint
# at contrast >=9.3 against Atom One Light's ink.
#
# Slots 0/2/4 keep their family across a flip (teal, blue, violet), so a repo that
# reads "the teal one" in dark still reads teal in light. The statusline GLYPH is
# hashed separately and does not change with the scheme, so it is the part of a
# session's identity that survives a flip intact.
PALETTE = {
    "dark":  ("#4db5bb", "#46d9ff", "#51afef", "#2257a0", "#a9a1e1", "#c678dd"),
    #          teal       cyan       blue       dark-blue  violet     magenta
    "light": ("#29758e", "#146b14", "#2531b1", "#a15017", "#b81fd6", "#d61f4c"),
    #          teal       green      blue       amber      violet     rose
}

# Glyphs for the per-session statusline marker. Indexed by a SEPARATE hash from
# the colour, so glyph and hue vary independently — six hues × ten glyphs gives
# plenty of distinct (glyph, colour) pairs to tell same-repo sessions apart.
GLYPHS = ("◆", "●", "▲", "■", "✦", "❖", "⬢", "◈", "✚", "▼")

# Per-scheme theme background + how much accent to blend in for the bg tint.
# `bg` must track ghostty's own theme (`theme = light:Atom One Light,dark:Doom
# One`), since an OSC-11 background replaces it rather than tinting it.
#
# There is no border_darken knob any more: it existed because the light scheme
# reused the dark accents and had to darken them to be visible on white. The
# light accents above are already chosen dark enough to carry a border and to
# read as statusline text (each is >=4.5 contrast on #f9f9f9), and darkening
# them again only muddied them.
THEME = {
    "dark":  {"bg": "#282c34", "frac": 0.28},
    "light": {"bg": "#f9f9f9", "frac": 0.20},
}


def run(*args: str) -> str | None:
    """Run a command, returning stripped stdout or None on any failure."""
    try:
        out = subprocess.run(args, capture_output=True, text=True, timeout=2)
    except (OSError, subprocess.SubprocessError):
        return None
    return out.stdout.strip() if out.returncode == 0 else None


def _env_pid() -> int | None:
    try:
        return int(os.environ["TERM_IDENT_PID"])
    except (KeyError, ValueError):
        return None


def _ppid(pid: int) -> int | None:
    """Parent of a pid. Split on the LAST ")" — /proc/<pid>/stat embeds the comm
    in parens and a comm may contain spaces, so a plain split() misreads it."""
    try:
        return int(open(f"/proc/{pid}/stat").read().rsplit(")", 1)[1].split()[1])
    except (OSError, IndexError, ValueError):
        return None


def ghostty_pid(start: int | None = None) -> int | None:
    """Walk the /proc ppid chain up to the ghostty process that owns us.

    `start` (or $TERM_IDENT_PID) overrides the starting point so `retint` can
    resolve a window it is not itself a descendant of. Passing a ghostty pid
    directly is fine — the loop tests the starting pid first."""
    pid = start or _env_pid() or os.getpid()
    for _ in range(16):
        try:
            comm = open(f"/proc/{pid}/comm").read().strip()
        except OSError:
            return None
        if comm == "ghostty":
            return pid
        ppid = _ppid(pid)
        if ppid is None or ppid in (0, pid):
            return None
        pid = ppid
    return None


def ghostty_address(start: int | None = None) -> str | None:
    """Map the owning ghostty process to a Hyprland window address.

    Hyprland-only: the per-window border tint is set via `hyprctl setprop`, which
    has no niri equivalent (niri can't recolor a single window's border at
    runtime). Under niri this returns None, so the border step no-ops while the
    OSC-11 background tint — which is just a terminal escape — still applies."""
    if os.environ.get("XDG_CURRENT_DESKTOP") != "Hyprland" or not _have("hyprctl"):
        return None
    gpid = ghostty_pid(start)
    if gpid is None:
        return None
    clients = run("hyprctl", "clients", "-j")
    if not clients:
        return None
    try:
        return next(c["address"] for c in json.loads(clients) if c.get("pid") == gpid)
    except (StopIteration, ValueError):
        return None


def _have(cmd: str) -> bool:
    return any(os.access(os.path.join(p, cmd), os.X_OK) for p in os.get_exec_path())


# Opacity for the neutral / no-project state ($HOME etc.) — a "ghostly when
# idle" cue. In a project the window is opaque (props reset to the global 1.0).
IDLE_ALPHA, IDLE_ALPHA_INACTIVE = 0.85, 0.72


def _setprop(addr: str, **props: object) -> None:
    """Set Hyprland window props. NB: for color props, -1 restores the global
    default; for opacity, -1 is taken literally and clamps to 0 (invisible!), so
    opacity must always be reset with an explicit 1, never -1.

    Prop names are the Hyprland >=0.56 snake_case ones (0.55 and earlier used
    activebordercolor / alpha / alphainactive — no aliases exist either way)."""
    for prop, val in props.items():
        run("hyprctl", "dispatch", "setprop", f"address:{addr}", prop, str(val))


def apply_window(active: str, inactive: str, pid: int | None = None) -> None:
    """In a project: colored border + fully opaque (opacity explicitly 1)."""
    addr = ghostty_address(pid)
    if addr:
        _setprop(addr, active_border_color=active, inactive_border_color=inactive,
                 opacity=1, opacity_inactive=1)


def reset_window() -> None:
    """Neutral state: default border + slight transparency."""
    addr = ghostty_address()
    if addr:
        _setprop(addr, active_border_color=-1, inactive_border_color=-1,
                 opacity=IDLE_ALPHA, opacity_inactive=IDLE_ALPHA_INACTIVE)


def write_tty(seq: str, tty: str | None = None) -> None:
    """Write an escape sequence to the session's terminal.

    Resolved to a real /dev/pts/N first: opening "/dev/tty" fails outright in a
    process with no controlling terminal, which is exactly the case for the
    Claude UserPromptSubmit hook — so the per-session tint used to reach the
    border (set by pid, via hyprctl) but never the background."""
    target = resolve_tty(tty)
    if not target:
        return
    try:
        with open(target, "w") as t:
            t.write(seq)
    except OSError:
        pass


def set_bg(hex6: str, tty: str | None = None) -> None:
    write_tty(f"\033]11;#{hex6}\033\\", tty)   # OSC 11 — set background


def reset_bg(tty: str | None = None) -> None:
    write_tty("\033]111\033\\", tty)        # OSC 111 — reset background


def _ctty(pid: int) -> str | None:
    """A process's controlling terminal as /dev/pts/N, from /proc/<pid>/stat.

    tty_nr (field 7) is a dev_t: major in bits 8-19, minor in the low 8 bits plus
    bits 20-31. Only UNIX98 pts (major 136) can be a ghostty window."""
    try:
        fields = open(f"/proc/{pid}/stat").read().rsplit(")", 1)[1].split()
        tty_nr = int(fields[4])
    except (OSError, IndexError, ValueError):
        return None
    if tty_nr == 0 or (tty_nr >> 8) & 0xfff != 136:
        return None
    path = f"/dev/pts/{(tty_nr & 0xff) | ((tty_nr >> 12) & 0xfff00)}"
    return path if os.path.exists(path) else None


def resolve_tty(tty: str | None = None) -> str | None:
    """Real /dev/pts/N our OSC writes should target.

    /dev/tty is a magic per-process device and must never be stored: as a state
    key every session collides on one file, and as a replay target it means
    "whatever terminal is reading this record", which for `retint` — spawned from
    a waybar click or a keybind — is no terminal at all, so the write silently
    goes nowhere. os.ttyname() is no help either: handed an fd opened on /dev/tty
    it returns "/dev/tty" straight back.

    So read tty_nr out of /proc instead, walking UP the ppid chain: the Claude
    UserPromptSubmit hook has no controlling terminal of its own (its stdio are
    pipes), but the zsh that started Claude does, and it is the same pts."""
    target = tty or TTY
    if target != "/dev/tty":
        return target                      # an explicit target is already real
    pid = os.getpid()
    for _ in range(16):
        found = _ctty(pid)
        if found:
            return found
        ppid = _ppid(pid)
        if ppid is None or ppid in (0, pid):
            return None
        pid = ppid
    return None


def _state_path(tty: str) -> str:
    key = tty.removeprefix("/dev/").replace("/", "-")
    return os.path.join(STATE_DIR, f"tty-{key}.json")


def save_state(seed: str, tty: str | None = None, pid: int | None = None,
               scheme_name: str | None = None) -> None:
    """Record what this session is showing, so `retint` can replay it after a
    scheme flip. The seed is stored rather than recomputed on purpose: it may have
    come from a Claude prompt (term-ident-claude) rather than the git toplevel, so
    re-deriving it would silently reassign window identities. The scheme is stored
    so `ensure` can tell "already showing this" from "stale since the last flip"."""
    resolved = resolve_tty(tty)
    if not resolved:
        return
    record = {"seed": seed, "tty": resolved, "ghostty_pid": pid or ghostty_pid(),
              "scheme": scheme_name or cached_scheme()}
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        path = _state_path(resolved)
        tmp = f"{path}.tmp"
        with open(tmp, "w") as f:
            json.dump(record, f)
        os.replace(tmp, path)     # atomic — retint may be reading concurrently
    except OSError:
        pass


def clear_state() -> None:
    """Drop this session's record: a reset session needs no replay, since OSC 111
    and border -1 both fall back to values that are already scheme-correct."""
    resolved = resolve_tty()
    if not resolved:
        return
    try:
        os.unlink(_state_path(resolved))
    except OSError:
        pass


def _rgb(hex6: str) -> tuple[int, int, int]:
    h = hex6.lstrip("#")
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def _hex(rgb: tuple[int, int, int]) -> str:
    return "%02x%02x%02x" % rgb


def _mix(a: tuple, b: tuple, f: float) -> tuple:
    # round half-up (int(x+0.5)) so output is bit-identical to term-ident.rb
    return tuple(int(a[i] * (1 - f) + b[i] * f + 0.5) for i in range(3))


def accent_for(seed: str, scheme_name: str | None = None) -> str:
    palette = PALETTE[scheme_name or cached_scheme()]
    return palette[zlib.crc32(seed.encode()) % len(palette)]


def glyph_for(seed: str) -> str:
    # separate hash → glyph and colour are independent (see GLYPHS note)
    return GLYPHS[zlib.crc32(b"glyph:" + seed.encode()) % len(GLYPHS)]


def scheme() -> str:
    """The active scheme, "light" or "dark".

    Read from gsettings because that is what toggle-color-scheme (Super+Shift+T)
    sets, and that is the switch which flips ghostty. Unset/auto counts as dark,
    matching that script's own default.

    ⚠️ Do NOT "fix" this to read the xdg-desktop-portal appearance or DMS's own
    isLightMode. There are two independent light/dark switches here: the DMS UI
    switch moves GTK4/libadwaita apps and Chromium but leaves ghostty alone. The
    portal tracks that other one, and it is a convincing trap — at the `default`
    value of color-scheme the portal reports no-preference (0), which libadwaita
    and DMS render as light while ghostty stays dark. A tint blended against the
    portal's answer would be inverted against what the terminal is showing."""
    val = run("gsettings", "get", "org.gnome.desktop.interface", "color-scheme") or ""
    return "light" if "prefer-light" in val else "dark"


def cached_scheme() -> str:
    """scheme() without the gsettings spawn, for hot paths — claude-statusline
    re-derives an accent on every render. toggle-color-scheme rewrites this marker
    on every flip (and on --apply at session start); a missing or junk marker just
    costs the real lookup."""
    try:
        with open(SCHEME_MARKER) as f:
            val = f.read().strip()
    except OSError:
        return scheme()
    return val if val in THEME else scheme()


def apply_seed(seed: str, tty: str | None = None, pid: int | None = None) -> None:
    name = scheme()
    t = THEME[name]
    border = accent = _rgb(accent_for(seed, name))
    theme_bg = _rgb(t["bg"])
    black = (0, 0, 0)

    bg = _mix(theme_bg, accent, t["frac"])               # accent blended into theme bg
    active = f"rgba({_hex(border)}ee) rgba({_hex(_mix(border, black, 0.30))}ee) 45deg"
    inactive = f"rgba({_hex(_mix(border, theme_bg, 0.45))}aa)"

    set_bg(_hex(bg), tty)
    apply_window(active, inactive, pid)
    save_state(seed, tty, pid, name)


def ensure(seed: str) -> None:
    """Apply the seed only if this session is not already showing it, unchanged,
    under the current scheme.

    The self-heal path for Claude sessions. A shell re-runs `project` from its
    precmd hook on every prompt, so it repairs itself the moment anything moves;
    a Claude session prints no shell prompt for the whole time it runs, so a flip
    partway through would otherwise leave it wearing the old scheme's tint —
    which on a flip to light is a dark background under Atom One Light's dark ink.
    A prompt submission is the one event such a session does produce, so that is
    where the check goes; when nothing has changed it costs one file read."""
    resolved = resolve_tty()
    name = scheme()
    if resolved:
        try:
            with open(_state_path(resolved)) as f:
                record = json.load(f)
            if record.get("seed") == seed and record.get("scheme") == name:
                return
        except (OSError, ValueError):
            pass
    apply_seed(seed)


def reset_all() -> None:
    reset_bg()
    reset_window()
    clear_state()


def retint() -> None:
    """Re-apply every recorded session against the current scheme.

    Called by toggle-color-scheme after it flips gsettings. Records whose tty or
    ghostty process is gone are pruned as we go."""
    try:
        names = sorted(os.listdir(STATE_DIR))
    except OSError:
        return
    for name in names:
        if not (name.startswith("tty-") and name.endswith(".json")):
            continue
        path = os.path.join(STATE_DIR, name)
        try:
            with open(path) as f:
                record = json.load(f)
        except (OSError, ValueError):
            continue
        seed, tty, pid = record.get("seed"), record.get("tty"), record.get("ghostty_pid")
        # A record must name a real pts. Older builds stored the literal
        # "/dev/tty", which every session resolved to — so they all collided on
        # one file, and replaying it wrote to whatever terminal `retint` itself
        # had, i.e. none. Those records are unusable; drop them on sight.
        alive = bool(seed) and bool(tty) and tty.startswith("/dev/pts/") \
            and os.path.exists(tty) and (not pid or os.path.exists(f"/proc/{pid}"))
        if not alive:
            try:
                os.unlink(path)
            except OSError:
                pass
            continue
        apply_seed(seed, tty, pid)


def main(argv: list[str]) -> int:
    cmd = argv[0] if argv else "project"
    if cmd == "reset":
        reset_all()
    elif cmd == "seed":
        apply_seed(argv[1]) if len(argv) > 1 and argv[1] else reset_all()
    elif cmd == "ensure":
        ensure(argv[1]) if len(argv) > 1 and argv[1] else None
    elif cmd == "retint":
        retint()
    elif cmd in ("project", ""):
        directory = argv[1] if len(argv) > 1 else os.getcwd()
        top = run("git", "-C", directory, "rev-parse", "--show-toplevel")
        apply_seed(top) if top else reset_all()
    elif cmd == "identity":
        seed = argv[1] if len(argv) > 1 else ""
        print(json.dumps({"glyph": glyph_for(seed), "accent": accent_for(seed),
                          "scheme": cached_scheme()}))
    else:
        print("usage: term-ident {project [dir]|seed <string>|ensure <string>|"
              "reset|retint|identity <string>}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
