#!/usr/bin/env python3
"""term-ident — give a ghostty window a stable visual identity from a seed.

A seed string is hashed to a hue, which drives two coordinated cues so that
parallel terminals are recognizable at a glance:

  - a subtle, theme-aware BACKGROUND tint   (OSC 11 -> the controlling tty)
  - a vivid per-window BORDER gradient        (hyprctl dispatch setprop)

Border is the strong, theme-independent cue; the bg tint is the peripheral
bonus. Degrades to a no-op outside Hyprland / when not running under ghostty.

Both cues are computed against the ACTIVE color scheme, so a dark<->light flip
invalidates them — an OSC-11 background in particular overrides ghostty's own
theme background and will not recompute itself. Every applied seed is therefore
recorded under $XDG_RUNTIME_DIR/term-ident/, and `term-ident retint` replays
those records against the current scheme. toggle-color-scheme calls it on every
flip.

Usage:
  term-ident project [dir]   seed from the git toplevel of dir (default $PWD);
                             resets to defaults when dir is not in a repo
  term-ident seed <string>   seed from an arbitrary string
  term-ident reset           clear tint + border (back to theme defaults)
  term-ident retint          re-apply every recorded session for the current
                             scheme; prunes records of dead sessions
  term-ident identity <str>  print {glyph, accent} JSON for a seed — used by the
                             Claude statusline so its marker matches the border

Env:
  TERM_IDENT_TTY   tty to receive OSC sequences (default /dev/tty)
  TERM_IDENT_PID   pid to start the ghostty ppid-chain walk from (default self);
                   lets `retint` resolve a window it is not a descendant of
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
import zlib

TTY = os.environ.get("TERM_IDENT_TTY", "/dev/tty")

# Per-session records, keyed by tty. Shares the directory term-ident-claude uses
# for its per-session statusline files; tmpfs, so it clears itself on logout.
STATE_DIR = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "term-ident")

# Cool accents from the theme palette (Doom One + doom-emacs extended). Every
# tint derives from one of these, so colors always sit on-theme. Edit the list
# to retune the palette; backgrounds are these accents blended into the theme
# background, borders are the accents themselves.
PALETTE = ("#4db5bb", "#46d9ff", "#51afef", "#2257a0", "#a9a1e1", "#c678dd")
#           teal       cyan       blue       dark-blue  violet     magenta

# Glyphs for the per-session statusline marker. Indexed by a SEPARATE hash from
# the colour, so glyph and hue vary independently — six hues × ten glyphs gives
# plenty of distinct (glyph, colour) pairs to tell same-repo sessions apart.
GLYPHS = ("◆", "●", "▲", "■", "✦", "❖", "⬢", "◈", "✚", "▼")

# Per-scheme theme background + how much accent to blend in for the bg tint.
THEME = {
    "dark":  {"bg": "#282c34", "frac": 0.28, "border_darken": 0.00},
    "light": {"bg": "#f9f9f9", "frac": 0.20, "border_darken": 0.30},
}


def run(*args: str) -> str | None:
    """Run a command, returning stripped stdout or None on any failure."""
    try:
        out = subprocess.run(args, capture_output=True, text=True, timeout=2)
    except (OSError, subprocess.SubprocessError):
        return None
    return out.stdout.strip() if out.returncode == 0 else None


def _env_pid() -> int | None:
    try:
        return int(os.environ["TERM_IDENT_PID"])
    except (KeyError, ValueError):
        return None


def ghostty_pid(start: int | None = None) -> int | None:
    """Walk the /proc ppid chain up to the ghostty process that owns us.

    `start` (or $TERM_IDENT_PID) overrides the starting point so `retint` can
    resolve a window it is not itself a descendant of. Passing a ghostty pid
    directly is fine — the loop tests the starting pid first."""
    pid = start or _env_pid() or os.getpid()
    for _ in range(16):
        try:
            comm = open(f"/proc/{pid}/comm").read().strip()
            ppid = int(open(f"/proc/{pid}/stat").read().split()[3])
        except (OSError, IndexError, ValueError):
            return None
        if comm == "ghostty":
            return pid
        if ppid in (0, pid):
            return None
        pid = ppid
    return None


def ghostty_address(start: int | None = None) -> str | None:
    """Map the owning ghostty process to a Hyprland window address.

    Hyprland-only: the per-window border tint is set via `hyprctl setprop`, which
    has no niri equivalent (niri can't recolor a single window's border at
    runtime). Under niri this returns None, so the border step no-ops while the
    OSC-11 background tint — which is just a terminal escape — still applies."""
    if os.environ.get("XDG_CURRENT_DESKTOP") != "Hyprland" or not _have("hyprctl"):
        return None
    gpid = ghostty_pid(start)
    if gpid is None:
        return None
    clients = run("hyprctl", "clients", "-j")
    if not clients:
        return None
    try:
        return next(c["address"] for c in json.loads(clients) if c.get("pid") == gpid)
    except (StopIteration, ValueError):
        return None


def _have(cmd: str) -> bool:
    return any(os.access(os.path.join(p, cmd), os.X_OK) for p in os.get_exec_path())


# Opacity for the neutral / no-project state ($HOME etc.) — a "ghostly when
# idle" cue. In a project the window is opaque (props reset to the global 1.0).
IDLE_ALPHA, IDLE_ALPHA_INACTIVE = 0.85, 0.72


def _setprop(addr: str, **props: object) -> None:
    """Set Hyprland window props. NB: for color props, -1 restores the global
    default; for opacity, -1 is taken literally and clamps to 0 (invisible!), so
    opacity must always be reset with an explicit 1, never -1.

    Prop names are the Hyprland >=0.56 snake_case ones (0.55 and earlier used
    activebordercolor / alpha / alphainactive — no aliases exist either way)."""
    for prop, val in props.items():
        run("hyprctl", "dispatch", "setprop", f"address:{addr}", prop, str(val))


def apply_window(active: str, inactive: str, pid: int | None = None) -> None:
    """In a project: colored border + fully opaque (opacity explicitly 1)."""
    addr = ghostty_address(pid)
    if addr:
        _setprop(addr, active_border_color=active, inactive_border_color=inactive,
                 opacity=1, opacity_inactive=1)


def reset_window() -> None:
    """Neutral state: default border + slight transparency."""
    addr = ghostty_address()
    if addr:
        _setprop(addr, active_border_color=-1, inactive_border_color=-1,
                 opacity=IDLE_ALPHA, opacity_inactive=IDLE_ALPHA_INACTIVE)


def write_tty(seq: str, tty: str | None = None) -> None:
    try:
        with open(tty or TTY, "w") as t:
            t.write(seq)
    except OSError:
        pass


def set_bg(hex6: str, tty: str | None = None) -> None:
    write_tty(f"\033]11;#{hex6}\033\\", tty)   # OSC 11 — set background


def reset_bg() -> None:
    write_tty("\033]111\033\\")            # OSC 111 — reset background


def resolve_tty(tty: str | None = None) -> str | None:
    """Real device path of our OSC target. /dev/tty is a magic per-process device,
    so it must be resolved to the actual /dev/pts/N before it can key state."""
    target = tty or TTY
    try:
        fd = os.open(target, os.O_RDONLY | os.O_NOCTTY)
    except OSError:
        return None
    try:
        return os.ttyname(fd)
    except OSError:
        return None if target == "/dev/tty" else target
    finally:
        os.close(fd)


def _state_path(tty: str) -> str:
    key = tty.removeprefix("/dev/").replace("/", "-")
    return os.path.join(STATE_DIR, f"tty-{key}.json")


def save_state(seed: str, tty: str | None = None, pid: int | None = None) -> None:
    """Record what this session is showing, so `retint` can replay it after a
    scheme flip. The seed is stored rather than recomputed on purpose: it may have
    come from a Claude prompt (term-ident-claude) rather than the git toplevel, so
    re-deriving it would silently reassign window identities."""
    resolved = resolve_tty(tty)
    if not resolved:
        return
    record = {"seed": seed, "tty": resolved, "ghostty_pid": pid or ghostty_pid()}
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        path = _state_path(resolved)
        tmp = f"{path}.tmp"
        with open(tmp, "w") as f:
            json.dump(record, f)
        os.replace(tmp, path)     # atomic — retint may be reading concurrently
    except OSError:
        pass


def clear_state() -> None:
    """Drop this session's record: a reset session needs no replay, since OSC 111
    and border -1 both fall back to values that are already scheme-correct."""
    resolved = resolve_tty()
    if not resolved:
        return
    try:
        os.unlink(_state_path(resolved))
    except OSError:
        pass


def _rgb(hex6: str) -> tuple[int, int, int]:
    h = hex6.lstrip("#")
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def _hex(rgb: tuple[int, int, int]) -> str:
    return "%02x%02x%02x" % rgb


def _mix(a: tuple, b: tuple, f: float) -> tuple:
    # round half-up (int(x+0.5)) so output is bit-identical to term-ident.rb
    return tuple(int(a[i] * (1 - f) + b[i] * f + 0.5) for i in range(3))


def accent_for(seed: str) -> str:
    return PALETTE[zlib.crc32(seed.encode()) % len(PALETTE)]


def glyph_for(seed: str) -> str:
    # separate hash → glyph and colour are independent (see GLYPHS note)
    return GLYPHS[zlib.crc32(b"glyph:" + seed.encode()) % len(GLYPHS)]


def scheme_is_light() -> bool:
    val = run("gsettings", "get", "org.gnome.desktop.interface", "color-scheme") or ""
    return "prefer-light" in val      # default to dark when unset/auto


def apply_seed(seed: str, tty: str | None = None, pid: int | None = None) -> None:
    t = THEME["light" if scheme_is_light() else "dark"]
    accent = _rgb(accent_for(seed))
    theme_bg = _rgb(t["bg"])
    black = (0, 0, 0)

    bg = _mix(theme_bg, accent, t["frac"])               # accent blended into theme bg
    border = _mix(accent, black, t["border_darken"])     # darkened on light for contrast
    active = f"rgba({_hex(border)}ee) rgba({_hex(_mix(border, black, 0.30))}ee) 45deg"
    inactive = f"rgba({_hex(_mix(border, theme_bg, 0.45))}aa)"

    set_bg(_hex(bg), tty)
    apply_window(active, inactive, pid)
    save_state(seed, tty, pid)


def reset_all() -> None:
    reset_bg()
    reset_window()
    clear_state()


def retint() -> None:
    """Re-apply every recorded session against the current scheme.

    Called by toggle-color-scheme after it flips gsettings. Records whose tty or
    ghostty process is gone are pruned as we go."""
    try:
        names = sorted(os.listdir(STATE_DIR))
    except OSError:
        return
    for name in names:
        if not (name.startswith("tty-") and name.endswith(".json")):
            continue
        path = os.path.join(STATE_DIR, name)
        try:
            with open(path) as f:
                record = json.load(f)
        except (OSError, ValueError):
            continue
        seed, tty, pid = record.get("seed"), record.get("tty"), record.get("ghostty_pid")
        alive = bool(seed) and bool(tty) and os.path.exists(tty) \
            and (not pid or os.path.exists(f"/proc/{pid}"))
        if not alive:
            try:
                os.unlink(path)
            except OSError:
                pass
            continue
        apply_seed(seed, tty, pid)


def main(argv: list[str]) -> int:
    cmd = argv[0] if argv else "project"
    if cmd == "reset":
        reset_all()
    elif cmd == "seed":
        apply_seed(argv[1]) if len(argv) > 1 and argv[1] else reset_all()
    elif cmd == "retint":
        retint()
    elif cmd in ("project", ""):
        directory = argv[1] if len(argv) > 1 else os.getcwd()
        top = run("git", "-C", directory, "rev-parse", "--show-toplevel")
        apply_seed(top) if top else reset_all()
    elif cmd == "identity":
        seed = argv[1] if len(argv) > 1 else ""
        print(json.dumps({"glyph": glyph_for(seed), "accent": accent_for(seed)}))
    else:
        print("usage: term-ident {project [dir]|seed <string>|reset|retint|"
              "identity <string>}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
