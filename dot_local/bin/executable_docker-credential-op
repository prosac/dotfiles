#!/usr/bin/env bash
# docker-credential-op — a docker/podman credential helper answered by 1Password.
#
# Nothing is stored on disk: `get` reads the item whose *title is the registry host* from the
# vault in OP_REGISTRY_VAULT (default: Employee), an "API Credential" with the fields `username`
# and `credential` — or a Login item, whose `password` is the secret. Wire it up per registry in a
# file that holds no secret:
#
#   ~/.config/containers/auth.json   (podman)      {"credHelpers": {"docker.cvhero.com": "op"}}
#   ~/.docker/config.json            (docker)      same key
#
# Protocol: https://github.com/docker/docker-credential-helpers — the exact not-found sentence on
# stdout with exit 1 is what makes a client fall back to an anonymous pull for other registries.
set -euo pipefail

vault="${OP_REGISTRY_VAULT:-Employee}"
not_found="credentials not found in native keychain"

# Rootless podman re-executes itself inside its user namespace, and everything it spawns — this
# helper included — lives there. The 1Password desktop app refuses a CLI calling from a namespace
# (`connecting to desktop app: read: connection reset`, measured 2026-09-21). The user's systemd
# manager is outside the namespace, so from inside, the helper runs itself again through it, stdin
# and stdout piped. Outside (an identity uid_map) this is a no-op, so docker on macOS never sees it.
if [ -r /proc/self/uid_map ] && [ "$(awk 'NR==1 {print $1, $2, $3}' /proc/self/uid_map)" != "0 0 4294967295" ] \
   && command -v systemd-run >/dev/null; then
  exec systemd-run --user --pipe --quiet --wait --collect -- "$0" "$@"
fi

case "${1:-}" in
  get)
    # docker and podman send the server without a trailing newline: read hits EOF, the value stays.
    read -r server || true
    host="${server#*://}"
    host="${host%%/*}"
    [ -n "$host" ] || { echo "$not_found"; exit 1; }
    # The whole item, not `--fields label=…`: asking for a label the item does not have fails the call.
    if ! item=$(op item get "$host" --vault "$vault" --format json 2>/dev/null); then
      echo "$not_found"
      exit 1
    fi
    jq -en --arg server "$server" --argjson item "$item" '
      ($item.fields // []) as $fs
      | {ServerURL: $server,
         Username: ($fs[] | select(.label == "username") | .value),
         Secret:   (first($fs[] | select(.label == "credential" or .label == "password") | select((.value // "") != "") | .value))}
      | select(.Username != "" and .Secret != "" and .Username != "FILL-ME")' \
      || { echo "$not_found"; exit 1; }
    ;;
  store|erase)
    echo "docker-credential-op: refusing to $1 — logins live in 1Password, not on disk" >&2
    exit 1
    ;;
  list)
    echo '{}'
    ;;
  version)
    echo "docker-credential-op 1.0"
    ;;
  *)
    echo "usage: docker-credential-op get|store|erase|list  (server URL on stdin for get)" >&2
    exit 1
    ;;
esac
