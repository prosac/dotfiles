#!/usr/bin/env python3
"""Rebuild the hyprtasking plugin against the currently installed Hyprland headers.

Hyprland plugins are ABI-pinned to the exact compositor build, so the .so has to
be rebuilt after EVERY Hyprland update or `hyprctl plugin load` fails and the
Super+Tab overview is silently gone (hyprland.conf's exec-once notifies instead).

What it does:
  1. refuses to build when the installed hyprland-devel headers do not match the
     Hyprland package — building against the wrong headers is exactly what makes
     a plugin crash the compositor on load;
  2. reconfigures + compiles ~/.local/src/hyprtasking (meson);
  3. hot-swaps the plugin in the running session (unload + load), unless
     --no-reload.

⚠️ The checkout is the unmerged 0.56.1 fix (raybbian/hyprtasking#123, fork
yerlotic) because upstream main only supports Hyprland <= 0.56.0. After a
Hyprland MINOR bump the fork may not compile at all — then check whether #123
merged and move to `hyprpm add https://github.com/raybbian/hyprtasking`.

The running compositor's version is deliberately NOT consulted: after `dnf
upgrade` the packages are new while the session still runs the old build, and the
plugin must be built for what the NEXT login will run.

See ~/Documents/docs/hyprland-hyprtasking-plugin.md
"""

import argparse
import os
import subprocess
import sys

SRC = os.path.expanduser("~/.local/src/hyprtasking")
SO = os.path.join(SRC, "build", "libhyprtasking.so")


def run(cmd, **kw):
    return subprocess.run(cmd, text=True, capture_output=True, **kw)


def rpm_version(pkg):
    res = run(["rpm", "-q", "--qf", "%{evr}", pkg])
    return res.stdout.strip() if res.returncode == 0 else None


def check_headers():
    """hyprland and hyprland-devel must be the same build, else refuse."""
    runtime, headers = rpm_version("hyprland"), rpm_version("hyprland-devel")
    if headers is None:
        sys.exit(
            "hyprland-devel is not installed — no headers to build against.\n"
            f"  sudo dnf install -y --refresh hyprland-devel-{runtime}"
        )
    if runtime != headers:
        sys.exit(
            f"version mismatch: hyprland {runtime} vs hyprland-devel {headers}.\n"
            "Building against mismatched headers crashes the compositor on load.\n"
            f"  sudo dnf install -y --refresh hyprland-devel-{runtime}"
        )
    print(f"→ headers match hyprland {runtime}")
    return runtime


def build():
    if not os.path.isdir(SRC):
        sys.exit(f"plugin source missing at {SRC}")
    setup = run(
        ["meson", "setup", "build", "--reconfigure", "--buildtype=debug"], cwd=SRC
    )
    if setup.returncode != 0:
        sys.exit(f"meson setup failed:\n{setup.stdout}\n{setup.stderr}")
    compile_ = run(["meson", "compile", "-C", "build"], cwd=SRC)
    if compile_.returncode != 0:
        sys.exit(
            f"compile failed:\n{compile_.stdout}\n{compile_.stderr}\n"
            "A Hyprland minor bump likely broke the plugin's API use — check\n"
            "whether raybbian/hyprtasking#123 merged and switch to upstream."
        )
    print(f"→ built {SO} ({os.path.getsize(SO) // 1024 // 1024} MiB)")


def reload_plugin():
    """Hot-swap in the running session; harmless if it was never loaded."""
    run(["hyprctl", "plugin", "unload", SO])
    res = run(["hyprctl", "plugin", "load", SO])
    if res.returncode != 0 or "ok" not in res.stdout:
        sys.exit(f"plugin load failed: {res.stdout.strip()} {res.stderr.strip()}")
    listing = run(["hyprctl", "plugin", "list"]).stdout
    if "Hyprtasking" not in listing:
        sys.exit("loaded without error but the plugin is not in `hyprctl plugin list`")
    print("→ loaded into the running session")


def notify(colour, text):
    """Best-effort desktop notification; never fatal if the shell is not up yet."""
    run(["hyprctl", "notify", "-1", "8000", colour, f"hyprtasking: {text}"])


def is_loaded():
    return "Hyprtasking" in run(["hyprctl", "plugin", "list"]).stdout


def try_load():
    """Load the existing .so. True only if it ends up in `plugin list`.

    ⚠️ Check `is_loaded()` BEFORE calling this. `hyprctl plugin load` REFUSES a
    plugin that is already loaded, so on an already-healthy session this would
    answer False and send us off to rebuild something that was never broken.

    The listing is also the only honest success test even for a genuine load:
    `hyprctl plugin load` prints its error on STDOUT and still exits 0, so the
    exit code cannot be trusted -- the same trap the exec-once line documents.
    """
    res = run(["hyprctl", "plugin", "load", SO])
    if res.returncode != 0 or "ok" not in res.stdout:
        return False
    return is_loaded()


def ensure():
    """Load the plugin, rebuilding it first only if the current .so will not load.

    This is what the session's exec-once calls. Plugins are ABI-pinned to the
    exact compositor build, so ANY hyprland update -- including a release bump
    like 0.56.2-1 -> -2 from a routine `dnf update` -- makes the built .so
    unloadable. Before this, the session came up with the plugin missing and its
    dispatchers undefined, which Hyprland reports as `Invalid dispatcher:
    hyprtasking:toggle` in its on-screen Error Overlay, and the fix was a manual
    rebuild nobody remembers is needed.

    Cost is paid only when it is actually needed: on a normal login the load
    succeeds and nothing is compiled.
    """
    if is_loaded():
        print("→ plugin already loaded (nothing to do)")
        return
    if not os.path.isfile(SO):
        print("no built plugin yet — building")
    elif try_load():
        print("→ plugin loaded (no rebuild needed)")
        return
    else:
        print("→ plugin failed to load (Hyprland was probably updated) — rebuilding")
        notify("rgb(ff8800)", "rebuilding for the new Hyprland build...")

    try:
        check_headers()
        build()
        reload_plugin()
    except SystemExit as exc:
        # check_headers()/build()/reload_plugin() exit with a message on failure.
        # Surface it on screen too: exec-once output goes to the Hyprland log,
        # which is not somewhere a failure gets noticed.
        notify("rgb(ff0000)", f"rebuild FAILED — {exc}")
        raise
    notify("rgb(00ff00)", f"rebuilt for hyprland {rpm_version('hyprland')}")


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument(
        "--no-reload",
        action="store_true",
        help="build only; do not touch the running compositor",
    )
    ap.add_argument(
        "--ensure",
        action="store_true",
        help="load the existing build; rebuild ONLY if it will not load "
        "(what the session's exec-once runs)",
    )
    args = ap.parse_args()

    if args.ensure:
        ensure()
        return

    check_headers()
    build()
    if args.no_reload:
        print("→ skipped reload (--no-reload); it loads on next login")
    else:
        reload_plugin()


if __name__ == "__main__":
    main()
