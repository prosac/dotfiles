{{/* Rendered by `chezmoi init` to ~/.config/chezmoi/chezmoi.toml.
     `promptStringOnce` / `promptChoiceOnce` preserve values already set,
     so re-running init does not re-prompt for keys you've answered. */ -}}

{{- $name := promptStringOnce . "name" "Git name (user.name in .gitconfig)" -}}
{{- $email := promptStringOnce . "email" "Git email" -}}
{{- $machineClass := promptChoiceOnce . "machineClass" "Machine class" (list "laptop" "desktop") -}}
{{- $machineRole := promptChoiceOnce . "machineRole" "Machine role (work = deploy work-only tooling, e.g. asyncapi CLI completions)" (list "personal" "work") -}}
{{- $passwordManager := promptChoiceOnce . "passwordManager" "Password manager" (list "1password" "bitwarden" "none") -}}
{{- $mailSetup := promptBoolOnce . "mailSetup" "Deploy notmuch + lieer Gmail setup on this machine" false -}}

{{/* LAN git peering: push commits straight to the other machine over ssh.
     Opt-in per machine, like mailSetup. The two follow-ups are prompted only
     when it is enabled, but the keys are always emitted so templates and
     .chezmoiignore can reference them without a missing-key error. */ -}}
{{- $gitPeerSetup := promptBoolOnce . "gitPeerSetup" "Set up LAN git peering with another machine" false -}}

{{- $gitPeerHost := "" -}}
{{- $gitPeerLan := "" -}}
{{- if $gitPeerSetup -}}
{{-   $gitPeerHost = promptStringOnce . "gitPeerHost" "  Peer machine's DNS name (the OTHER machine, e.g. box.example.lan)" -}}
{{-   $gitPeerLan = promptStringOnce . "gitPeerLan" "  LAN CIDR allowed to reach sshd (e.g. 10.0.0.0/24)" -}}
{{- end -}}

{{/* Where this machine keeps its checkouts. sandy mounts repos from here, so
     it is the one path a workspace profile cannot hardcode and stay portable.
     Templates read it with `dig` and default to ~/repos, so a machine that has
     not re-run `chezmoi init` since this key appeared still applies cleanly. */ -}}
{{- $reposRoot := promptStringOnce . "reposRoot" "Where your git checkouts live (sandy mounts repos from here)" "~/repos" -}}
{{- $sandyWorkspace := promptStringOnce . "sandyWorkspace" "Default sandy workspace on this machine (blank = the only one there is)" "" -}}

[data]
name = {{ $name | quote }}
email = {{ $email | quote }}
machineClass = {{ $machineClass | quote }}
machineRole = {{ $machineRole | quote }}
passwordManager = {{ $passwordManager | quote }}
mailSetup = {{ $mailSetup }}
gitPeerSetup = {{ $gitPeerSetup }}
gitPeerHost = {{ $gitPeerHost | quote }}
gitPeerLan = {{ $gitPeerLan | quote }}
reposRoot = {{ $reposRoot | quote }}
sandyWorkspace = {{ $sandyWorkspace | quote }}
